{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daylight-chart",
  "compatibility_date": "2026-08-04",
  // Static-assets-only Worker: no "main" script, the assets runtime serves dist
  // directly. public/_headers still applies.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
